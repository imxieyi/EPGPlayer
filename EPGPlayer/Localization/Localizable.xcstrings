    "Accessing HTTP server over public Internet is not secure. Only do this if your server is on the local network or behind a VPN. Do you wish to continue?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開インターネット経由でのHTTPサーバーへのアクセスは安全ではありません。サーバーがローカルネットワーク上にあるか、VPNの背後にある場合にのみ実行してください。続行しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过公开网络访问HTTP服务器不安全，请仅在本地网络或者启用VPN的情况下使用。是否继续？"
          }
        }
      }
    },
